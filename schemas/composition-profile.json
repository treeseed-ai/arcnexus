{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcnexus.local/schemas/composition-profile-v1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "enum": [
        1,
        3
      ]
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "platformId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "packageIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[a-zA-Z0-9_-]+$"
      },
      "uniqueItems": true
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "platformId",
    "packageIds"
  ],
  "additionalProperties": false
}
