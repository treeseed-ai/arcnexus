{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcnexus.local/schemas/assignment-v1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "change",
        "research",
        "review"
      ]
    },
    "expectedOutcome": {
      "type": "string",
      "minLength": 1
    },
    "acceptanceCriteria": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "allowedWritePaths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "hostChecks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_-]+$"
          },
          "command": {
            "type": "string",
            "minLength": 1
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "artifacts": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "command",
          "args",
          "artifacts"
        ],
        "additionalProperties": false
      }
    },
    "changeType": {
      "enum": [
        "behavior",
        "documentation"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "objective",
    "kind",
    "expectedOutcome",
    "acceptanceCriteria",
    "hostChecks"
  ],
  "additionalProperties": false
}