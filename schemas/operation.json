{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "const": "command"
    },
    "repository": {
      "type": "string",
      "minLength": 1
    },
    "cwd": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "enum": [
        "build",
        "unit-test",
        "integration-test",
        "cli-check",
        "http-check"
      ]
    },
    "activities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "command": {
      "type": "string",
      "minLength": 1
    },
    "args": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "timeoutSeconds": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 120
    },
    "generatedDirectories": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "artifacts": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "probes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "command": {
            "type": "string",
            "minLength": 1
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "command",
          "args"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "purpose",
    "kind",
    "repository",
    "cwd",
    "category",
    "activities",
    "command",
    "args",
    "timeoutSeconds",
    "generatedDirectories",
    "artifacts",
    "probes"
  ]
}