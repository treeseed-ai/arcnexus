{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "command",
        "service",
        "http"
      ]
    },
    "repository": {
      "type": "string",
      "minLength": 1
    },
    "cwd": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "enum": [
        "build",
        "unit-test",
        "integration-test",
        "cli-check",
        "http-check",
        "lint"
      ]
    },
    "activities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "command": {
      "type": "string",
      "minLength": 1
    },
    "args": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "timeoutSeconds": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 120
    },
    "generatedDirectories": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "artifacts": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "probes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "command": {
            "type": "string",
            "minLength": 1
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "command",
          "args"
        ]
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "readinessPath": {
          "type": "string",
          "pattern": "^/[^/]*"
        },
        "expectedStatus": {
          "type": "integer",
          "minimum": 200,
          "maximum": 299
        },
        "startupTimeoutSeconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 120
        }
      },
      "required": [
        "port",
        "readinessPath",
        "expectedStatus",
        "startupTimeoutSeconds"
      ]
    },
    "http": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "serviceId": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "pattern": "^/[^/]*"
        },
        "expectedStatus": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599
        }
      },
      "required": [
        "serviceId",
        "path",
        "expectedStatus"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "purpose",
    "kind",
    "repository",
    "cwd",
    "category",
    "activities",
    "timeoutSeconds",
    "generatedDirectories",
    "artifacts",
    "probes"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "http"
          }
        }
      },
      "then": {
        "properties": {
          "http": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "serviceId": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": "string",
                "pattern": "^/[^/]*"
              },
              "expectedStatus": {
                "type": "integer",
                "minimum": 100,
                "maximum": 599
              }
            },
            "required": [
              "serviceId",
              "path",
              "expectedStatus"
            ]
          },
          "command": false,
          "args": false,
          "service": false
        },
        "required": [
          "http"
        ]
      },
      "else": {
        "properties": {
          "command": {
            "type": "string",
            "minLength": 1
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "command",
          "args"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "service"
          }
        }
      },
      "then": {
        "properties": {
          "service": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "port": {
                "type": "integer",
                "minimum": 0,
                "maximum": 65535
              },
              "readinessPath": {
                "type": "string",
                "pattern": "^/[^/]*"
              },
              "expectedStatus": {
                "type": "integer",
                "minimum": 200,
                "maximum": 299
              },
              "startupTimeoutSeconds": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 120
              }
            },
            "required": [
              "port",
              "readinessPath",
              "expectedStatus",
              "startupTimeoutSeconds"
            ]
          },
          "http": false
        },
        "required": [
          "service"
        ]
      },
      "else": {
        "properties": {
          "service": false
        }
      }
    }
  ]
}
