{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcnexus.local/schemas/role-v1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "enum": [
        1,
        3
      ]
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "responsibilities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "activities": {
      "type": "array",
      "items": {
        "enum": [
          "research",
          "documentation",
          "testing",
          "implementation",
          "review",
          "release"
        ]
      },
      "uniqueItems": true
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "purpose",
    "responsibilities",
    "activities"
  ],
  "additionalProperties": false
}
