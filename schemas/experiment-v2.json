{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "modes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "simulation",
          "live"
        ]
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_-]+$"
              },
              "project": {
                "type": "string",
                "minLength": 1
              },
              "base": {
                "type": "string",
                "pattern": "^[a-f0-9]{40}$"
              },
              "component": {
                "type": "string",
                "minLength": 1
              },
              "assignment": {
                "type": "string",
                "minLength": 1
              },
              "expectedOutcome": {
                "enum": [
                  "ready_for_integration",
                  "blocked",
                  "research_completed",
                  "review_completed"
                ]
              },
              "acceptance": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "properties": {
                    "command": {
                      "type": "string",
                      "minLength": 1
                    },
                    "args": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "artifacts": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  },
                  "required": [
                    "command",
                    "args",
                    "artifacts"
                  ],
                  "additionalProperties": false
                }
              },
              "maxAttempts": {
                "enum": [
                  1,
                  2
                ]
              },
              "faultInjection": {
                "type": "string",
                "minLength": 1
              },
              "scenario": {
                "enum": [
                  "success",
                  "repair",
                  "boundary",
                  "failure"
                ]
              },
              "priorEvidenceIds": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "id",
              "project",
              "component",
              "assignment",
              "expectedOutcome",
              "acceptance"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_-]+$"
              },
              "project": {
                "type": "string",
                "minLength": 1
              },
              "base": {
                "type": "string",
                "pattern": "^[a-f0-9]{40}$"
              },
              "acceptance": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "properties": {
                    "command": {
                      "type": "string",
                      "minLength": 1
                    },
                    "args": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "artifacts": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  },
                  "required": [
                    "command",
                    "args",
                    "artifacts"
                  ],
                  "additionalProperties": false
                }
              },
              "workday": {
                "type": "string",
                "minLength": 1
              },
              "expectedOutcome": {
                "enum": [
                  "completed",
                  "blocked"
                ]
              },
              "scenario": {
                "const": "handoff"
              }
            },
            "required": [
              "id",
              "project",
              "workday",
              "expectedOutcome",
              "acceptance"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "modes",
    "cases"
  ],
  "additionalProperties": false
}
