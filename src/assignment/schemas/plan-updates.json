{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9_-]+$"
      },
      "status": {
        "enum": ["pending", "in_progress", "completed", "skipped", "blocked"]
      },
      "explanation": {
        "type": "string",
        "minLength": 1
      },
      "evidence": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "required": ["id", "status", "explanation", "evidence"]
  },
  "$id": "https://arcnexus.local/schemas/plan-updates-v1"
}
