{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcnexus.local/schemas/execution-profile-v1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "enum": [1, 2, 3]
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "reasoning": {
      "enum": ["low", "medium", "high"]
    },
    "webSearch": {
      "enum": ["live", "disabled"]
    },
    "timeoutSeconds": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 2147483
    },
    "commandTimeoutSeconds": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 2147483
    },
    "maxTurns": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "maxCorrectiveTurns": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "operationCategories": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "maxOperationCalls": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "maxChecklistCalls": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "maxAttempts": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": ["schemaVersion", "id", "model", "reasoning", "webSearch"],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "const": 1
          }
        }
      },
      "then": {
        "properties": {
          "operationCategories": false,
          "maxOperationCalls": false
        }
      }
    }
  ]
}
