{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "enum": [1, 3]
    },
    "requester": {
      "type": "object",
      "properties": {
        "component": {
          "type": "string",
          "minLength": 1
        },
        "assignment": {
          "type": "string",
          "minLength": 1
        },
        "maxAttempts": {
          "type": "integer",
          "minimum": 1
        },
        "refresh": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "command": {
                "type": "string",
                "minLength": 1
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": ["command", "args"],
            "additionalProperties": false
          }
        }
      },
      "required": ["component", "assignment", "refresh"],
      "additionalProperties": false
    },
    "recipient": {
      "type": "object",
      "properties": {
        "component": {
          "type": "string",
          "minLength": 1
        },
        "assignment": {
          "type": "string",
          "minLength": 1
        },
        "maxAttempts": {
          "type": "integer",
          "minimum": 1
        },
        "refresh": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "command": {
                "type": "string",
                "minLength": 1
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": ["command", "args"],
            "additionalProperties": false
          }
        }
      },
      "required": ["component", "assignment", "refresh"],
      "additionalProperties": false
    },
    "dependency": {
      "type": "object",
      "properties": {
        "from": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "contract": {
          "type": "string",
          "minLength": 1
        },
        "delivery": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["from", "to", "contract", "delivery"],
      "additionalProperties": false
    },
    "acceptance": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "command": {
            "type": "string",
            "minLength": 1
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "id": {
            "type": "string",
            "minLength": 1
          },
          "artifacts": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": ["id", "command", "args", "artifacts"],
        "additionalProperties": false
      }
    },
    "timeoutSeconds": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 2147483
    },
    "maxCoordinationTurns": {
      "type": "integer",
      "minimum": 1
    }
  },
  "required": ["schemaVersion", "requester", "recipient", "dependency", "acceptance"],
  "additionalProperties": false,
  "$id": "https://arcnexus.local/schemas/workday-v1"
}
