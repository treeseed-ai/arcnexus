{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": ["completed", "blocked", "failed"]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0
          },
          "verdict": {
            "type": "string",
            "enum": ["verified", "gap"]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "explanation": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["index", "verdict", "evidence", "explanation"],
        "additionalProperties": false
      }
    },
    "deficiencies": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": ["status", "summary", "criteria", "deficiencies"],
  "additionalProperties": false,
  "$id": "https://arcnexus.local/schemas/verification-result-v1"
}
