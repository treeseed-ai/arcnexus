{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcnexus.local/schemas/experiment-v3-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "modes", "cases"],
  "properties": {
    "schemaVersion": {
      "const": 3
    },
    "modes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["simulation", "live"]
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "project", "prompt", "expectedOutcome"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]+$"
          },
          "project": {
            "type": "string",
            "minLength": 1
          },
          "prompt": {
            "type": "string",
            "minLength": 1
          },
          "expectedOutcome": {
            "enum": ["completed", "needs_input", "needs_attention", "failed"]
          }
        }
      }
    }
  }
}
