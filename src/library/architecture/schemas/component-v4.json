{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcnexus.local/schemas/component-v4",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 4
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "type": {
      "enum": ["platform", "package", "foundation", "gateway", "library", "release"]
    },
    "repository": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "objectives": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "interfaces": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "relatedIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[a-zA-Z0-9_-]+$"
      },
      "uniqueItems": true
    },
    "role": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "executionProfile": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "access": {
      "type": "object",
      "properties": {
        "readPaths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "writeDirectories": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": ["readPaths", "writeDirectories"],
      "additionalProperties": false
    },
    "verification": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "command": {
            "type": "string",
            "minLength": 1
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": ["command", "args"],
        "additionalProperties": false
      }
    },
    "parentId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "operationIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "initialization": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 3
        },
        "componentId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["schemaVersion", "componentId"],
      "additionalProperties": false
    },
    "repositoryRoot": {
      "type": "string",
      "minLength": 1
    },
    "patternIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "ownership": {
      "type": "object",
      "properties": {
        "paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "publicModules": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "directoryExceptions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["path", "reason"],
            "additionalProperties": false
          }
        }
      },
      "required": ["paths", "publicModules", "directoryExceptions"],
      "additionalProperties": false
    },
    "discovery": {
      "type": "object",
      "properties": {
        "source": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "documentation": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "tests": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": ["source", "documentation", "tests", "exclude"],
      "additionalProperties": false
    },
    "coverageExclusions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["path", "reason"],
        "additionalProperties": false
      }
    },
    "provides": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": ["json-schema", "typescript"]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "compatibility": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["id", "version", "kind", "path", "compatibility"],
        "additionalProperties": false
      }
    },
    "consumes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["id", "version"],
        "additionalProperties": false
      }
    },
    "testProfile": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]+$"
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "type",
    "purpose",
    "path",
    "objectives",
    "constraints",
    "questions",
    "interfaces",
    "relatedIds",
    "role",
    "executionProfile",
    "access",
    "verification"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "package"
          }
        }
      },
      "then": {
        "required": ["repository", "repositoryRoot"],
        "properties": {
          "repository": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_-]+$"
          },
          "repositoryRoot": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "enum": ["foundation", "gateway", "library", "release"]
          }
        }
      },
      "then": {
        "required": ["parentId", "ownership"],
        "properties": {
          "repository": false,
          "repositoryRoot": false,
          "parentId": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_-]+$"
          },
          "ownership": {
            "type": "object",
            "properties": {
              "paths": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "publicModules": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "directoryExceptions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string"
                    },
                    "reason": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": ["path", "reason"],
                  "additionalProperties": false
                }
              }
            },
            "required": ["paths", "publicModules", "directoryExceptions"],
            "additionalProperties": false
          }
        }
      }
    }
  ]
}
