{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "runner": {
      "type": "string",
      "minLength": 1
    },
    "codexPath": {
      "type": "string",
      "minLength": 1
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]+$"
          },
          "project": {
            "type": "string",
            "minLength": 1
          },
          "base": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          },
          "component": {
            "type": "string",
            "minLength": 1
          },
          "assignment": {
            "type": "string",
            "minLength": 1
          },
          "expectedOutcome": {
            "enum": [
              "ready_for_integration",
              "blocked",
              "research_completed",
              "review_completed"
            ]
          },
          "bindings": {
            "type": "string",
            "minLength": 1
          },
          "issue": {
            "type": "string",
            "minLength": 1
          },
          "faultInjection": {
            "type": "string",
            "minLength": 1
          },
          "maxAttempts": {
            "type": "integer",
            "minimum": 1
          },
          "acceptance": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "command": {
                  "type": "string",
                  "minLength": 1
                },
                "args": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "artifacts": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "required": [
                "command",
                "args",
                "artifacts"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "project",
          "base",
          "component",
          "assignment",
          "expectedOutcome",
          "acceptance"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "runner",
    "cases"
  ],
  "additionalProperties": false,
  "$id": "https://arcnexus.local/schemas/campaign-v1"
}
