{
  "prerequisites": [
    {
      "command": "node",
      "args": [
        "-e",
        "if(process.versions.node.split('.')[0]!=='22')process.exit(1)"
      ]
    },
    {
      "command": "git",
      "args": [
        "--version"
      ]
    },
    {
      "command": "setsid",
      "args": [
        "--version"
      ]
    }
  ],
  "setup": [
    {
      "command": "npm",
      "args": [
        "ci",
        "--no-audit",
        "--no-fund"
      ]
    },
    {
      "command": "npm",
      "args": [
        "run",
        "build"
      ]
    }
  ],
  "generatedDirectories": [
    "node_modules",
    "dist"
  ],
  "schemaVersion": 1,
  "workspace": {
    "primary": {
      "id": "arcnexus",
      "repository": "https://github.com/treeseed-ai/arcnexus.git"
    },
    "dependencies": []
  }
}
